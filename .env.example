# comment2jira credentials.
#
# Copy to .env and fill in real values. Never commit .env.
# Every variable the application reads must be listed here with a comment.

# Base URL of the Jira instance (Cloud or Server/Data Center).
JIRA_URL=

# Account email. Set it for Cloud basic auth; leave it empty for a
# Server/Data Center personal access token.
JIRA_EMAIL=

# API token (Cloud) or personal access token (Server/Data Center).
JIRA_TOKEN=

# Auth scheme override: auto (default), basic or bearer. With auto, an email
# present means basic and an email absent means bearer. Same as --auth.
JIRA_AUTH=

# Path to the .env file to read, overriding ./.env and the per-user location.
# Same as --env-file. Set this in the real environment, not inside a .env file:
# a file cannot name itself.
COMMENT2JIRA_ENV_FILE=
