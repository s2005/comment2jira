# Credentials for the live-Jira integration suite (tests/integration).
#
# Copy this file to test.env and fill in real values. test.env is
# gitignored by the `*.env` rule and must never be committed.
#
# The suite is opt-in: it is skipped unless pytest is given the path to
# this file (any location works) with --jira-env-file:
#
#   uv run pytest tests/integration -q --jira-env-file test.env
#
# Every variable the integration suite reads is listed below.

# Base URL of the Jira instance under test (Cloud or Server/Data Center).
# Required.
JIRA_URL=https://your-site.atlassian.net

# Account email. Set it for Cloud basic auth; leave it empty for a
# Server/Data Center personal access token. Optional.
JIRA_EMAIL=you@example.com

# API token (Cloud) or personal access token (Server/Data Center).
# Required.
JIRA_TOKEN=

# Auth scheme override: auto (default), basic or bearer. With auto, an
# email present means basic and an email absent means bearer. Optional.
JIRA_AUTH=auto

# Key of a scratch issue the suite may comment on and attach files to.
# The tests post real comments and upload real attachments to it, so point
# this at a throwaway issue, never at a live ticket. Required.
JIRA_TEST_ISSUE=SCRATCH-1
